rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, photoURL, role, createdAt
    //
    // Collection: reports
    // Fields: userId, locationName, lat, lng, algaeLevel, foamDetected, turbidity, overallScore, recommendation, details, imageUrl, timestamp, status
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          request.auth.token.email == "devansh0547@gmail.com");
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['user', 'admin'];
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'overallScore', 'timestamp', 'locationName', 'algaeLevel', 'foamDetected', 'turbidity', 'recommendation', 'details', 'status']) &&
             data.userId is string &&
             data.overallScore is number &&
             data.timestamp is string &&
             data.locationName is string &&
             data.algaeLevel in ['None', 'Low', 'Moderate', 'High', 'Critical', 'Unknown'] &&
             data.foamDetected is bool &&
             data.turbidity in ['Clear', 'Slightly Cloudy', 'Cloudy', 'Opaque', 'Unknown'] &&
             data.recommendation is string &&
             data.details is string &&
             data.status in ['Pending', 'In Review', 'Action Taken', 'Resolved'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == resource.data.role || isAdmin());
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidReport(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 2000;
      allow read: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
